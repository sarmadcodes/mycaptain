{
    "expo":  {
                 "name":  "My Captain",
                 "slug":  "my-captain",
                 "version":  "1.0.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/images/icon.png",
                 "scheme":  "mycaptain",
                 "userInterfaceStyle":  "light",
                 "ios":  {
                             "icon":  "./assets/expo.icon",
                             "bundleIdentifier":  "com.mycaptain.app"
                         },
                 "android":  {
                                 "adaptiveIcon":  {
                                                      "backgroundColor":  "#101C30",
                                                      "foregroundImage":  "./assets/images/android-icon-foreground.png",
                                                      "backgroundImage":  "./assets/images/android-icon-background.png",
                                                      "monochromeImage":  "./assets/images/android-icon-monochrome.png"
                                                  },
                                 "predictiveBackGestureEnabled":  false,
                                 "package":  "com.mycaptain.app"
                             },
                 "web":  {
                             "output":  "static",
                             "favicon":  "./assets/images/favicon.png"
                         },
                 "plugins":  [
                                 "expo-router",
                                 "expo-secure-store",
                                 [
                                     "expo-splash-screen",
                                     {
                                         "imageWidth":  76,
                                         "backgroundColor":  "#101C30",
                                         "image":  "./assets/images/splash-icon.png"
                                     }
                                 ],
                                 [
                                     "expo-location",
                                     {
                                         "locationAlwaysAndWhenInUsePermission":  "My Captain shares your location with operations only while you are on duty.",
                                         "locationWhenInUsePermission":  "My Captain uses your location to show pickup points and live duty tracking.",
                                         "isAndroidBackgroundLocationEnabled":  true
                                     }
                                 ],
                                 [
                                     "expo-image-picker",
                                     {
                                         "photosPermission":  "Attach photos and videos as evidence for incident reports."
                                     }
                                 ],
                                 "expo-notifications"
                             ],
                 "experiments":  {
                                     "typedRoutes":  true,
                                     "reactCompiler":  true
                                 }
             }
}
