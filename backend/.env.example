NODE_ENV=development
PORT=4000
# 127.0.0.1 in production, so only Nginx can reach the API.
HOST=0.0.0.0
# Comma-separated origins allowed to call the API (app web build, partner site, admin).
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/my-captain
# Required in production. Leave empty in development to use the built-in memory store.
REDIS_URL=

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_PEPPER=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS provider for login codes: console (development only) | twilio | http
SMS_PROVIDER=console
# Safety cap on codes sent per day across all users.
SMS_DAILY_LIMIT=2000
# twilio: Account SID, auth token, and either a sender number or a Messaging Service SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# http: any gateway with an HTTP API (Veevo Tech, SendPK, Eocean...). Placeholders: {to} {to_local} {text}
# e.g. SMS_HTTP_URL=https://gateway.example/api/send?key=YOUR_KEY&to={to_local}&msg={text}
SMS_HTTP_URL=
SMS_HTTP_METHOD=GET
SMS_HTTP_BODY=
SMS_HTTP_AUTH_HEADER=
# Text the gateway reply must contain to count as sent, if it returns 200 on errors.
SMS_HTTP_SUCCESS=

# First admin account, created by `npm run seed`.
SEED_ADMIN_PHONE=3001112223
SEED_ADMIN_PASSWORD=

# Test numbers that skip SMS and accept OTP_TEST_CODE. Refused in production.
OTP_TEST_PHONES=
OTP_TEST_CODE=123456
